diff --git a/libavcodec/aacenc.c b/libavcodec/aacenc.c
index 5b1e3ef..2aef9ba 100644
--- a/libavcodec/aacenc.c
+++ b/libavcodec/aacenc.c
@@ -1283,6 +1283,28 @@ static void copy_input_samples(AACEncContext *s, const AVFrame *frame)
     }
 }
 
+/**
+ * Quantize the regularly coded bands more coarsely, by up to the given number
+ * of scalefactor steps (4 steps double the quantizer step size). The global
+ * gain stays, and so does every scalefactor difference's legal range.
+ */
+static void coarsen_scalefactors(SingleChannelElement *sce, int offset)
+{
+    int w, g, prev = sce->sf_idx[0];
+
+    for (w = 0; w < sce->ics.num_windows; w += sce->ics.group_len[w]) {
+        for (g = 0; g < sce->ics.max_sfb; g++) {
+            const int i = w*16 + g;
+            if (sce->zeroes[i] || sce->band_type[i] == NOISE_BT ||
+                sce->band_type[i] == INTENSITY_BT || sce->band_type[i] == INTENSITY_BT2)
+                continue;
+            if (i)
+                sce->sf_idx[i] = FFMIN3(sce->sf_idx[i] + offset, prev + SCALE_MAX_DIFF, SCALE_MAX_POS);
+            prev = sce->sf_idx[i];
+        }
+    }
+}
+
 static int aac_encode_frame(AVCodecContext *avctx, AVPacket *avpkt,
                             const AVFrame *frame, int *got_packet_ptr)
 {
@@ -1293,6 +1315,8 @@ static int aac_encode_frame(AVCodecContext *avctx, AVPacket *avpkt,
     IndividualChannelStream *ics;
     int i, its, ch, w, chans, tag, start_ch, ret, frame_bits;
     int target_bits, rate_bits, too_many_bits, too_few_bits;
+    int sf_offset;
+    float entry_lambda;
     int ms_mode = 0, is_mode = 0, tns_mode = 0, pred_mode = 0;
     int chan_el_counter[4];
     FFPsyWindowInfo windows[AAC_MAX_CHANNELS];
@@ -1425,6 +1449,8 @@ static int aac_encode_frame(AVCodecContext *avctx, AVPacket *avpkt,
     if ((ret = ff_alloc_packet(avctx, avpkt, 8192 * s->channels)) < 0)
         return ret;
     frame_bits = its = 0;
+    sf_offset = 0;
+    entry_lambda = s->lambda;
     do {
         init_put_bits(&s->pb, avpkt->data, avpkt->size);
 
@@ -1554,6 +1580,10 @@ static int aac_encode_frame(AVCodecContext *avctx, AVPacket *avpkt,
                 apply_mid_side_stereo(cpe);
             }
             adjust_frame_information(cpe, chans);
+            if (sf_offset) {
+                for (ch = 0; ch < chans; ch++)
+                    coarsen_scalefactors(&cpe->ch[ch], sf_offset);
+            }
             if (chans == 2) {
                 put_bits(&s->pb, 1, cpe->common_window);
                 if (cpe->common_window) {
@@ -1624,7 +1654,7 @@ static int aac_encode_frame(AVCodecContext *avctx, AVPacket *avpkt,
 
         if (   its == 0 /* for steady-state Q-scale tracking */
             || (its < 5 && (frame_bits < too_few_bits || frame_bits > too_many_bits))
-            || frame_bits >= 6144 * s->channels - 3  )
+            || (frame_bits >= 6144 * s->channels - 3 && its < 16)  )
         {
             float ratio = ((float)rate_bits) / frame_bits;
 
@@ -1644,7 +1674,7 @@ static int aac_encode_frame(AVCodecContext *avctx, AVPacket *avpkt,
             s->lambda = av_clipf(s->lambda * ratio, FLT_EPSILON, 65536.f);
 
             /* Keep iterating if we must reduce and lambda is in the sky */
-            if (ratio > 0.9f && ratio < 1.1f) {
+            if (ratio > 0.9f && ratio < 1.1f && frame_bits < 6144 * s->channels - 3) {
                 break;
             } else {
                 if (is_mode || ms_mode || tns_mode || pred_mode) {
@@ -1658,6 +1688,20 @@ static int aac_encode_frame(AVCodecContext *avctx, AVPacket *avpkt,
                 }
                 its++;
             }
+        } else if (frame_bits >= 6144 * s->channels - 3 && sf_offset < SCALE_MAX_DIFF) {
+            /* Lambda did not shrink the frame enough (the NMR coder does not
+             * follow it), so quantize what the coder chose more coarsely, a bit
+             * more on every try, at the lambda the frame started with */
+            sf_offset += 2;
+            s->lambda = entry_lambda;
+            if (is_mode || ms_mode || tns_mode || pred_mode) {
+                for (i = 0; i < s->chan_map[0]; i++) {
+                    chans = s->chan_map[i + 1] == TYPE_CPE ? 2 : 1;
+                    for (ch = 0; ch < chans; ch++)
+                        memcpy(s->cpe[i].ch[ch].coeffs, s->cpe[i].ch[ch].pcoeffs,
+                               sizeof(s->cpe[i].ch[ch].coeffs));
+                }
+            }
         } else {
             break;
         }
